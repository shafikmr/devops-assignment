
environment = "dev"
owner       = "devops-assignment"

instances = {
  web-server = {
    instance_type = "t3.micro"
    volume_type   = "gp3"
    volume_size   = 8
    key_name      = "devops-web"
    prevent_destroy = false
  }

  app-server = {
    instance_type = "t3.small"
    volume_type   = "gp3"
    volume_size   = 12
    key_name      = "devops-app"
    prevent_destroy = false
  }

  worker-server = {
    instance_type = "t3.medium"
    volume_type   = "gp3"
    volume_size   = 16
    key_name      = "devops-worker"
    prevent_destroy = false
  }

  database-server = {
    instance_type = "t3.small"
    volume_type   = "io1"
    volume_size   = 20
    iops          = 100
    key_name      = "devops-database"
    prevent_destroy = true
  }

  monitoring-server = {
    instance_type = "t3.micro"
    volume_type   = "gp3"
    volume_size   = 10
    key_name      = "devops-monitoring"
    prevent_destroy = false
  }
}
